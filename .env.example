# Analytics: GeoIP (conta gratuita em maxmind.com > My License Keys)
# MAXMIND_ACCOUNT_ID=
# MAXMIND_LICENSE_KEY=

# Painel /admin: sessao assinada (JWT). Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ADMIN_SESSION_SECRET=
